# Search Engine production example.
# Copy to /etc/search_engine.env and adjust limits/providers before enabling sync.

SEARCH_SYNC_LIMIT=500
SEARCH_SITEMAP_PROVIDERS_JSON='[{"name":"xvideos","sitemap_url":"https://www.xvideos.com/sitemap_new_videos.xml","max_pages":500,"delay_seconds":0.25,"timeout_seconds":15,"obey_robots":true,"sync_mode":"incremental"}]'
