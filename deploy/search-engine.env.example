# Search Engine production example.
# Copy the provider catalog to /etc/search_engine-providers.json and this file
# to /etc/search_engine.env before enabling sync.

SEARCH_SYNC_LIMIT=500
SEARCH_BACKFILL_BATCH_SIZE=500
SEARCH_BACKFILL_BATCHES_PER_PROVIDER=1
SEARCH_BACKFILL_MAX_SECONDS=180
SEARCH_PROVIDER_CONFIG_FILE=/etc/search_engine-providers.json

# Backward-compatible inline configuration remains supported. Prefer the
# separate JSON catalog when the provider list grows.
# SEARCH_SITEMAP_PROVIDERS_JSON='[{"name":"xvideos","sitemap_url":"https://www.xvideos.com/sitemap_new_videos.xml","max_pages":500,"delay_seconds":0.25,"timeout_seconds":15,"obey_robots":true,"sync_mode":"incremental"}]'
